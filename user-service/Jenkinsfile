pipeline {
    agent any
    options { timestamps() }
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Test') {
            steps {
                dir('user-service') {
                    bat 'mvn clean test'
                }
            }
        }
        stage('Package') {
            steps {
                dir('user-service') {
                    bat 'mvn package -DskipTests'
                }
            }
        }
        stage('Docker Build') {
            steps {
                dir('user-service') {
                    bat 'docker build -t ridgewood-user-service:latest .'
                }
            }
        }
    }
    post {
        always {
            junit testResults: 'user-service/target/surefire-reports/*.xml', allowEmptyResults: true
            archiveArtifacts artifacts: 'user-service/target/*.jar', fingerprint: true, allowEmptyArchive: true
        }
        success { echo 'user-service pipeline completed successfully.' }
        failure { echo 'user-service pipeline failed. Check Console Output.' }
    }
}
